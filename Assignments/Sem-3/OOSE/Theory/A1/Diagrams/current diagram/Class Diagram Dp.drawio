  <diagram name="Page-1" id="JMzFbJrjHk1Y3FfoneX9">
    <mxGraphModel dx="4772" dy="2248" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="light-dark(#FFFFFF,#000000)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class User {\n    &lt;&lt;abstract&gt;&gt;\n    +int userId\n    +String name\n    +String email\n    +String phone\n    +String role\n    +login()\n    +logout()\n  }\n  class Citizen {\n    +reportWaste()\n    +submitComplaint()\n    +trackCollection()\n  }\n  class MunicipalOfficer {\n    +manageBins()\n    +createSchedule()\n    +assignVehicle()\n    +allocateWorkers()\n    +viewDashboard()\n  }\n  class Driver {\n    +viewRoute()\n    +startCollection()\n    +updateVehicleStatus()\n    +shareLocation()\n  }\n  class Worker {\n    +viewAssignment()\n    +collectWaste()\n    +updateCollectionStatus()\n  }\n  class Supervisor {\n    +approveSchedule()\n    +monitorOperations()\n    +resolveComplaint()\n  }\n  class Administrator {\n    +manageUsers()\n    +configureSystem()\n    +viewAuditLogs()\n  }\n  class WasteBin {\n    +int binId\n    +String location\n    +float fillLevel\n    +String wasteType\n    +String status\n    +updateFillLevel()\n  }\n  class WasteReport {\n    +int reportId\n    +String imageUrl\n    +String description\n    +String location\n    +Date createdAt\n    +submit()\n  }\n  class WasteClassification {\n    +int classificationId\n    +String category\n    +float confidence\n    +classifyImage()\n  }\n  class CollectionSchedule {\n    +int scheduleId\n    +Date date\n    +String route\n    +String status\n    +create()\n    +approve()\n  }\n  class CollectionRequest {\n    +int requestId\n    +String priority\n    +String status\n    +create()\n    +updateStatus()\n  }\n  class Vehicle {\n    +int vehicleId\n    +String registrationNo\n    +String type\n    +String status\n  }\n  class GPSLocation {\n    +double latitude\n    +double longitude\n    +Date timestamp\n    +updateLocation()\n  }\n  class WorkerAssignment {\n    +int assignmentId\n    +Date assignedDate\n    +String status\n    +assign()\n  }\n  class Complaint {\n    +int complaintId\n    +String category\n    +String description\n    +String status\n    +submit()\n    +resolve()\n  }\n  class WasteCollection {\n    +int collectionId\n    +Date collectedAt\n    +float quantity\n    +String status\n    +recordCollection()\n  }\n  class DemandPrediction {\n    +int predictionId\n    +String area\n    +float predictedDemand\n    +Date predictionDate\n    +predictDemand()\n  }\n  class NotificationService {\n    +sendNotification()\n  }\n  class TrackingService {\n    +trackVehicle()\n    +getCurrentLocation()\n  }\n  class MLService {\n    +classifyWaste()\n    +predictDemand()\n  }\n  class AuditLog {\n    +int logId\n    +String action\n    +Date timestamp\n    +String userId\n  }\n\n  User &lt;|-- Citizen\n  User &lt;|-- MunicipalOfficer\n  User &lt;|-- Driver\n  User &lt;|-- Worker\n  User &lt;|-- Supervisor\n  User &lt;|-- Administrator\n  Citizen \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WasteReport : creates\n  Citizen \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Complaint : submits\n  WasteReport \&quot;1\&quot; --&gt; \&quot;1\&quot; WasteClassification : classified as\n  WasteBin \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CollectionRequest : generates\n  CollectionRequest \&quot;1\&quot; --&gt; \&quot;1\&quot; CollectionSchedule : scheduled in\n  CollectionSchedule \&quot;1\&quot; --&gt; \&quot;1\&quot; Vehicle : uses\n  CollectionSchedule \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WorkerAssignment : contains\n  WorkerAssignment \&quot;1\&quot; --&gt; \&quot;1\&quot; Worker : assigned worker\n  Vehicle \&quot;1\&quot; --&gt; \&quot;0..*\&quot; GPSLocation : sends\n  Vehicle \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WasteCollection : performs\n  Worker \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WasteCollection : performs\n  WasteBin \&quot;1\&quot; --&gt; \&quot;0..*\&quot; WasteCollection : collected from\n  MLService --&gt; WasteClassification : performs\n  MLService --&gt; DemandPrediction : generates\n  WasteBin --&gt; DemandPrediction : provides data\n  TrackingService --&gt; GPSLocation : reads\n  NotificationService --&gt; User : notifies\n  User --&gt; AuditLog : generates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
