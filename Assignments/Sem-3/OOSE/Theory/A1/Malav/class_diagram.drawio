      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Citizen {\n        +String citizenId\n        +String name\n        +String email\n        +String phone\n        +register()\n        +login()\n        +submitApplication()\n        +uploadDocument()\n        +trackApplication()\n    }\n\n    class UserAccount {\n        +String userId\n        +String username\n        +String passwordHash\n        +String role\n        +login()\n        +logout()\n        +validateCredentials()\n    }\n\n    class Application {\n        +String applicationId\n        +Date submissionDate\n        +String status\n        +String serviceType\n        +String priority\n        +String rejectionReason\n        +create()\n        +validate()\n        +updateStatus()\n        +trackStatus()\n    }\n\n    class Document {\n        +String documentId\n        +String documentType\n        +String filePath\n        +String verificationStatus\n        +upload()\n        +validate()\n        +replace()\n    }\n\n    class NlpMlEngine {\n        +classifyDocument()\n        +extractInformation()\n        +calculatePriority()\n        +analyzeApplication()\n    }\n\n    class VerificationService {\n        +verifyDocument()\n        +verifyExtractedData()\n        +requestAdditionalVerification()\n        +returnVerificationResult()\n    }\n\n    class GovernmentOfficer {\n        +String officerId\n        +String name\n        +String department\n        +reviewApplication()\n        +requestVerification()\n        +forwardForApproval()\n    }\n\n    class ApprovalAuthority {\n        +String authorityId\n        +String name\n        +String designation\n        +approveApplication()\n        +rejectApplication()\n        +provideReason()\n    }\n\n    class NotificationService {\n        +sendApprovalNotification()\n        +sendRejectionNotification()\n        +sendCorrectionRequest()\n        +sendStatusUpdate()\n    }\n\n    class AuditLog {\n        +String logId\n        +Date timestamp\n        +String action\n        +String actorId\n        +String details\n        +recordActivity()\n    }\n\n    class ApplicationService {\n        +createApplication()\n        +validateApplication()\n        +processDocuments()\n        +assignPriority()\n        +updateApplicationStatus()\n        +generateDecision()\n    }\n\n    Citizen \&quot;1\&quot; *-- \&quot;1\&quot; UserAccount : owns\n    Citizen \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Application : submits\n    Application \&quot;1\&quot; *-- \&quot;1..*\&quot; Document : contains\n    Application --&gt; ApplicationService : processed by\n    ApplicationService --&gt; NlpMlEngine : uses\n    ApplicationService --&gt; VerificationService : requests\n    ApplicationService --&gt; NotificationService : triggers\n    ApplicationService --&gt; AuditLog : records\n    GovernmentOfficer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Application : reviews\n    GovernmentOfficer --&gt; VerificationService : requests\n    GovernmentOfficer --&gt; ApprovalAuthority : forwards\n    ApprovalAuthority --&gt; Application : approves/rejects\n    NlpMlEngine --&gt; Document : analyzes\n    VerificationService --&gt; Document : verifies\n    NotificationService --&gt; Citizen : notifies\n    AuditLog --&gt; Application : records activity&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
