        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Citizen\n    participant Portal as Government Service Portal\n    participant Auth as Authentication Service\n    participant App as Application Service\n    participant NLP as NLP/ML Engine\n    participant Verify as Document Verification Service\n    participant Officer as Government Officer\n    participant Approver as Approval Authority\n    participant Notify as Notification Service\n    participant Audit as Audit Log\n\n    Citizen-&gt;&gt;Portal: Register / Login\n    Portal-&gt;&gt;Auth: Validate credentials\n    Auth--&gt;&gt;Portal: Authentication result\n    alt Authentication successful\n        Portal--&gt;&gt;Citizen: Show service dashboard\n        Citizen-&gt;&gt;Portal: Select service and submit application\n        Portal-&gt;&gt;App: Create application + documents\n        App-&gt;&gt;App: Validate required fields and documents\n        alt Application data incomplete\n            App--&gt;&gt;Portal: Missing / invalid information\n            Portal--&gt;&gt;Citizen: Request correction\n            Citizen-&gt;&gt;Portal: Resubmit corrected application\n            Portal-&gt;&gt;App: Update application\n        else Application data complete\n            App-&gt;&gt;NLP: Classify documents &amp; extract information\n            NLP--&gt;&gt;App: Document type + extracted data\n            App-&gt;&gt;Verify: Verify documents and extracted information\n            Verify--&gt;&gt;App: Verification result\n        end\n\n        alt Documents invalid\n            App-&gt;&gt;Notify: Send correction request\n            Notify--&gt;&gt;Citizen: Document correction notification\n            Citizen-&gt;&gt;Portal: Upload corrected documents\n            Portal-&gt;&gt;App: Resubmit documents\n            App-&gt;&gt;NLP: Reprocess documents\n            NLP--&gt;&gt;App: Updated classification / extraction\n            App-&gt;&gt;Verify: Verify corrected documents\n            Verify--&gt;&gt;App: Verification result\n        else Documents valid\n            App-&gt;&gt;NLP: Calculate application priority\n            NLP--&gt;&gt;App: Priority score\n            App-&gt;&gt;Officer: Send application for review\n            Officer-&gt;&gt;App: Review application\n            alt Additional verification required\n                Officer-&gt;&gt;Verify: Request additional verification\n                Verify--&gt;&gt;Officer: Verification result\n                Officer-&gt;&gt;App: Update review decision\n            end\n            Officer-&gt;&gt;Approver: Forward for approval\n            Approver-&gt;&gt;App: Approve / Reject application\n            alt Application approved\n                App-&gt;&gt;App: Generate service decision / certificate\n                App-&gt;&gt;Notify: Send approval notification\n                Notify--&gt;&gt;Citizen: Approval + service status\n            else Application rejected\n                App-&gt;&gt;App: Record rejection reason\n                App-&gt;&gt;Notify: Send rejection notification\n                Notify--&gt;&gt;Citizen: Rejection + reason\n            end\n        end\n        Citizen-&gt;&gt;Portal: Track application status\n        Portal-&gt;&gt;App: Retrieve current status\n        App--&gt;&gt;Portal: Application status\n        Portal--&gt;&gt;Citizen: Display status\n        App-&gt;&gt;Audit: Record application activity and decision\n        Audit--&gt;&gt;App: Audit entry stored\n    else Authentication failed\n        Auth--&gt;&gt;Portal: Reject login\n        Portal--&gt;&gt;Citizen: Display authentication error\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
